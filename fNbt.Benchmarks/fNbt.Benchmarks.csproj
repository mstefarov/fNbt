<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net48 needs .NET Framework, so off Windows it can be neither built nor run. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net48;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\bin\$(Configuration)\Benchmarks\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- FNbtNuGetVersion swaps the local build for a released package; see the baseline option in Program.cs. -->
  <ItemGroup Condition="'$(FNbtNuGetVersion)' == ''">
    <ProjectReference Include="..\fNbt\fNbt.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FNbtNuGetVersion)' != ''">
    <PackageReference Include="fNbt" Version="$(FNbtNuGetVersion)" />
  </ItemGroup>
  <!-- FNBT_BASELINE marks a build against a 1.x package, which lacks the 2.0 APIs some benchmarks use.
       Later snapshots run the whole suite. -->
  <PropertyGroup Condition="'$(FNbtNuGetVersion)' != '' and $([MSBuild]::VersionLessThan('$(FNbtNuGetVersion)', '2.0'))">
    <DefineConstants>$(DefineConstants);FNBT_BASELINE</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <None Update="TestFiles\bigtest.nbt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestFiles\cw-template.cw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\fNbt.Test\TestFiles\canonical_block_states.nbt" Link="TestFiles\canonical_block_states.nbt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
